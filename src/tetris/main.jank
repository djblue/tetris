(ns tetris.main
  (:include "raylib.h"
            "raygui.h"))

(def initial-state
  {:settings
   {:resolution
    {:screen-width 1280
     :screen-height 800}}})

(defonce state (atom initial-state))

(defn -main [& args]
  (let [{{{:keys [screen-width screen-height]} :resolution} :settings}  @state]
    (cpp/InitWindow screen-width screen-height "tetris")
    (cpp/SetTargetFPS 60)
    (while (cpp/! (cpp/WindowShouldClose))
      (cpp/BeginDrawing)
      (cpp/EndDrawing))
    (cpp/CloseWindow)))

(comment
  (def fut (future (-main))))